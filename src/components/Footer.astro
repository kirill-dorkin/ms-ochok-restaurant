---
import { homeContent } from "../config/home";
import { siteConfig } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <strong>{siteConfig.name.toUpperCase()}</strong>
      <p>{homeContent.footer.tagline}</p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow">Где</p>
      <p>{siteConfig.address.street}</p>
      <p>{siteConfig.address.locality}, {siteConfig.address.country}</p>
      <p>Адрес и телефон не указаны</p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow">Часы</p>
      <p>{siteConfig.hours.serviceDays}</p>
      <p>{siteConfig.hours.seatings}</p>
      <p>Выходные: {siteConfig.hours.closed}</p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow">Демо</p>
      <ul>
        {siteConfig.social.map((item) => (
          <li><a href={item.href} target="_blank" rel="noreferrer">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Демо MicroStudio на основе темы <a href="https://github.com/xocothemes/ombra">Ombra</a> — Andrei Alba, MIT.</p>
      <p><span class="ember-dot" aria-hidden="true"></span> {homeContent.footer.signal}</p>
    </div>
  </div>
</footer>
