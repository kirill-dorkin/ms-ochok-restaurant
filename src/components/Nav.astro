---
import { siteConfig } from "../config/site";
---

<header class="site-header">
  <div class="nav-grid">
    <a class="brand" href="#top" aria-label={`${siteConfig.name}, на главную`}>
      <span>{siteConfig.name.toUpperCase()}</span>
    </a>
    <nav class="nav-links" aria-label="Основная навигация">
      {siteConfig.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="button-link button-link--outline" href="#reserve">
        <span class="ember-dot" aria-hidden="true"></span>
        Бронь
      </a>
    </nav>
    <details class="mobile-nav">
      <summary class="mobile-nav__toggle">Меню</summary>
      <nav class="mobile-nav__panel" aria-label="Мобильная навигация">
        {siteConfig.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button-link" href="#reserve">Бронь</a>
      </nav>
    </details>
  </div>
</header>
